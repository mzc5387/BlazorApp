@page "/movies"
@rendermode InteractiveServer
@inject ITmdbService Tmdb

<PageTitle>Movies Search</PageTitle>

<h1>Search for Movies</h1>

<h3>Below is movie data from The Movie Database (TMDb)</h3>

<form @onsubmit="Search" @onsubmit:preventDefault>
    <input @bind="searchTerm" @bind:event="oninput" placeholder="Search movies..." />
    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="text-danger">Error: @errorMessage</div>
}

@if (results != null)
{
    if (results.Results.Count == 0)
    {
        <p>No movies found for "@searchTerm".</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th>Title</th>
                        <th>Release Date</th>
                        <th>Popularity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movie in results.Results)
                    {
                        <tr>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        @onclick="() => ToggleDetails(movie.Id)"
                                        aria-expanded="@IsExpanded(movie.Id)">
                                    @(IsExpanded(movie.Id) ? "Hide" : "Details")
                                </button>
                            </td>
                            <td>@movie.Title</td>
                            <td>@movie.Release_Date</td>
                            <td>@movie.Popularity.ToString("N1")</td>
                        </tr>

                        @if (IsExpanded(movie.Id))
                        {
                            <tr class="table-light">
                                <td colspan="4" class="p-3">
                                    <div class="row g-3">
                                        @if (!string.IsNullOrEmpty(movie.Poster_Path))
                                        {
                                            <div class="col-auto">
                                                <img src="https://image.tmdb.org/t/p/w185@(movie.Poster_Path)"
                                                     alt="@movie.Title poster"
                                                     class="img-thumbnail"
                                                     style="max-width: 185px;" />
                                            </div>
                                        }
                                        <div class="col">
                                            <h5 class="mb-2">@movie.Title</h5>
                                            <dl class="row mb-3">
                                                <dt class="col-sm-4 col-lg-3">Original title</dt>
                                                <dd class="col-sm-8 col-lg-9">@movie.OriginalTitle</dd>
                                                <dt class="col-sm-4 col-lg-3">Original language</dt>
                                                <dd class="col-sm-8 col-lg-9">@movie.OriginalLanguage</dd>
                                                <dt class="col-sm-4 col-lg-3">TMDB rating</dt>
                                                <dd class="col-sm-8 col-lg-9">@movie.VoteAverage.ToString("N1") / 10 (@movie.VoteCount votes)</dd>
                                            </dl>
                                            <h6>Overview</h6>
                                            <p class="mb-0">@(string.IsNullOrWhiteSpace(movie.Overview) ? "No overview available." : movie.Overview)</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string searchTerm = "";
    private MovieSearchResult? results;
    private string? errorMessage;
    private readonly HashSet<int> expandedMovieIds = new();

    private bool IsExpanded(int movieId) => expandedMovieIds.Contains(movieId);

    private void ToggleDetails(int movieId)
    {
        if (!expandedMovieIds.Add(movieId))
        {
            expandedMovieIds.Remove(movieId);
        }
    }

    private async Task Search()
    {
        errorMessage = null;
        results = null;
        expandedMovieIds.Clear();

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            errorMessage = "Please enter a search term.";
            return;
        }

        try
        {
            results = await Tmdb.SearchMoviesAsync(searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
