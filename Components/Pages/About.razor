@page "/about"

<PageTitle>About Me</PageTitle>

<div class="about-page">
    <p class="about-page__eyebrow">ABOUT ME</p>
    <h1>Hi, my name is Matt</h1>
    <p class="about-page__intro">
        I built this Blazor app as a hands-on way to explore public APIs and turn useful data into simple, approachable experiences.
    </p>

    <section class="about-page__section" aria-labelledby="project-title">
        <h2 id="project-title">What you’ll find here</h2>
        <p>
            This site brings together movie and TV-show discovery powered by TMDB, along with local NJ weather data from the National Weather Service.
            It is a growing collection of the topics and data sources I find most interesting.
        </p>
    </section>

    <section class="about-page__section" aria-labelledby="built-with-title">
        <h2 id="built-with-title">Built with</h2>
        <ul>
            <li>ASP.NET Core and Blazor</li>
            <li>Public APIs for live, useful data</li>
            <li>A focus on clear, practical interfaces</li>
        </ul>
    </section>
</div>
