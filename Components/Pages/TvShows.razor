@page "/tvshows"
@rendermode InteractiveServer
@inject ITmdbService Tmdb

<PageTitle>TV Shows Search</PageTitle>

<h1>Search for TV Shows</h1>

<h3>Below is TV show data from The Movie Database (TMDb)</h3>

<form @onsubmit="Search" @onsubmit:preventDefault>
    <input @bind="searchTerm" @bind:event="oninput" placeholder="Search TV shows..." />
    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="text-danger">Error: @errorMessage</div>
}

@if (results != null)
{
    if (results.Results.Count == 0)
    {
        <p>No TV shows found for "@searchTerm".</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th>Title</th>
                        <th>Release Date</th>
                        <th>Popularity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TvShow tvshow in results.Results)
                    {
                        <tr>
                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        @onclick="() => ToggleDetails(tvshow.Id)"
                                        aria-expanded="@IsExpanded(tvshow.Id)">
                                    @(IsExpanded(tvshow.Id) ? "Hide" : "Details")
                                </button>
                            </td>
                            <td>@tvshow.Name</td>
                            <td>@tvshow.First_Air_Date</td>
                            <td>@tvshow.Popularity.ToString("N1")</td>
                        </tr>

                        @if (IsExpanded(tvshow.Id))
                        {
                            <tr class="table-light">
                                <td colspan="4" class="p-3">
                                    <div class="row g-3">
                                        @if (!string.IsNullOrEmpty(tvshow.Poster_Path))
                                        {
                                            <div class="col-auto">
                                                <img src="https://image.tmdb.org/t/p/w185@(tvshow.Poster_Path)"
                                                     alt="@tvshow.Name poster"
                                                     class="img-thumbnail"
                                                     style="max-width: 185px;" />
                                            </div>
                                        }
                                        <div class="col">
                                            <h5 class="mb-2">@tvshow.Name</h5>
                                            <dl class="row mb-3">
                                                <dt class="col-sm-4 col-lg-3">Original title</dt>
                                                <dd class="col-sm-8 col-lg-9">@tvshow.Name</dd>
                                                <dt class="col-sm-4 col-lg-3">Original language</dt>
                                                <dd class="col-sm-8 col-lg-9">@tvshow.OriginalLanguage</dd>
                                                <dt class="col-sm-4 col-lg-3">TMDB rating</dt>
                                                <dd class="col-sm-8 col-lg-9">@tvshow.VoteAverage.ToString("N1") / 10 (@tvshow.VoteCount votes)</dd>
                                            </dl>
                                            <h6>Overview</h6>
                                            <p class="mb-0">@(string.IsNullOrWhiteSpace(tvshow.Overview) ? "No overview available." : tvshow.Overview)</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private string searchTerm = "";
    private TvShowSearchResult? results;
    private string? errorMessage;
    private readonly HashSet<int> expandedTvShowIds = new();

    private bool IsExpanded(int tvShowId) => expandedTvShowIds.Contains(tvShowId);

    private void ToggleDetails(int tvShowId)
    {
        if (!expandedTvShowIds.Add(tvShowId))
        {
            expandedTvShowIds.Remove(tvShowId);
        }
    }

    private async Task Search()
    {
        errorMessage = null;
        results = null;
        expandedTvShowIds.Clear();

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            errorMessage = "Please enter a search term.";
            return;
        }

        try
        {
            results = await Tmdb.SearchTvShowsAsync(searchTerm);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
