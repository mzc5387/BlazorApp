@page "/topmovies"
@rendermode InteractiveServer
@inject ITmdbService Tmdb

<PageTitle>Top Movies</PageTitle>

<h1>Top Movies</h1>
<p class="lead">The movies currently most popular on TMDB.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (movies is null)
{
    <p>Loading top movies...</p>
}
else if (movies.Results.Count == 0)
{
    <p>No top movies are available right now.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col"></th>
                    <th scope="col">Poster</th>
                    <th scope="col">Title</th>
                    <th scope="col">Release Date</th>
                    <th scope="col">TMDB Rating</th>
                    <th scope="col">Popularity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in movies.Results)
                {
                    <tr>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ToggleDetailsAsync(movie.Id)"
                                    aria-expanded="@IsExpanded(movie.Id)">
                                @(IsExpanded(movie.Id) ? "Hide" : "Details")
                            </button>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(movie.Poster_Path))
                            {
                                <a href="https://www.themoviedb.org/movie/@movie.Id"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Open @movie.Title on TMDB">
                                    <img src="https://image.tmdb.org/t/p/w92@(movie.Poster_Path)"
                                         alt="@movie.Title poster"
                                         class="img-thumbnail"
                                         style="width: 46px;" />
                                </a>
                            }
                        </td>
                        <td>
                            <strong>@movie.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(movie.Overview))
                            {
                                <div class="small text-body-secondary text-truncate" style="max-width: 32rem;">
                                    @movie.Overview
                                </div>
                            }
                        </td>
                        <td>@movie.Release_Date</td>
                        <td>@movie.VoteAverage.ToString("N1") <span class="text-body-secondary">(@movie.VoteCount)</span></td>
                        <td>@movie.Popularity.ToString("N1")</td>
                    </tr>

                    @if (IsExpanded(movie.Id))
                    {
                        <tr class="table-light">
                            <td colspan="6" class="p-3">
                                <div class="row g-3">
                                    @if (!string.IsNullOrEmpty(movie.Poster_Path))
                                    {
                                        <div class="col-auto">
                                            <a href="https://www.themoviedb.org/movie/@movie.Id"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                title="Open @movie.Title on TMDB">
                                                    <img src="https://image.tmdb.org/t/p/w92@(movie.Poster_Path)"
                                                        alt="@movie.Title poster"
                                                        class="img-thumbnail"
                                                        style="width: 185px;" />
                                            </a>
                                        </div>
                                    }
                                    <div class="col">
                                        <h5>@movie.Title</h5>
                                        <p>@(string.IsNullOrWhiteSpace(movie.Overview) ? "No overview available." : movie.Overview)</p>
                                        <h6 class="mt-3">Starring</h6>
                                        @if (loadingCredits.Contains(movie.Id))
                                        {
                                            <p class="mb-0">Loading cast...</p>
                                        }
                                        else if (creditErrors.TryGetValue(movie.Id, out var creditError))
                                        {
                                            <p class="text-danger mb-0">@creditError</p>
                                        }
                                        else if (movieCredits.TryGetValue(movie.Id, out var credits) && credits.Cast.Count > 0)
                                        {
                                            <ul class="list-group list-group-flush">
                                                @foreach (var castMember in credits.Cast.Take(10))
                                                {
                                                    <li class="list-group-item bg-transparent px-0 py-1">
                                                        <strong>@castMember.Name</strong>
                                                        @if (!string.IsNullOrWhiteSpace(castMember.Character))
                                                        {
                                                            <span class="text-body-secondary"> as @castMember.Character</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="mb-0">No cast information is available.</p>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private MovieSearchResult? movies;
    private string? errorMessage;
    private readonly HashSet<int> expandedMovieIds = new();
    private readonly HashSet<int> loadingCredits = new();
    private readonly Dictionary<int, MovieCredits> movieCredits = new();
    private readonly Dictionary<int, string> creditErrors = new();

    private bool IsExpanded(int movieId) => expandedMovieIds.Contains(movieId);

    private async Task ToggleDetailsAsync(int movieId)
    {
        if (!expandedMovieIds.Add(movieId))
        {
            expandedMovieIds.Remove(movieId);
            return;
        }

        if (movieCredits.ContainsKey(movieId) || loadingCredits.Contains(movieId))
        {
            return;
        }

        loadingCredits.Add(movieId);
        creditErrors.Remove(movieId);

        try
        {
            movieCredits[movieId] = await Tmdb.GetMovieCreditsAsync(movieId) ?? new MovieCredits();
        }
        catch (Exception ex)
        {
            creditErrors[movieId] = $"Unable to load cast: {ex.Message}";
        }
        finally
        {
            loadingCredits.Remove(movieId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            movies = await Tmdb.GetTopMoviesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load top movies: {ex.Message}";
        }
    }
}
