@page "/toptvshows"
@rendermode InteractiveServer
@inject ITmdbService Tmdb

<PageTitle>Top TV Shows</PageTitle>

<h1>Top TV Shows</h1>
<p class="lead">The TV shows currently most popular on TMDB.</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (tvshows is null)
{
    <p>Loading top tvshows...</p>
}
else if (tvshows.Results.Count == 0)
{
    <p>No top tvshows are available right now.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col"></th>
                    <th scope="col">Poster</th>
                    <th scope="col">Title</th>
                    <th scope="col">Release Date</th>
                    <th scope="col">TMDB Rating</th>
                    <th scope="col">Popularity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TvShow tvshow in tvshows.Results)
                {
                    <tr>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    @onclick="() => ToggleDetailsAsync(tvshow.Id)"
                                    aria-expanded="@IsExpanded(tvshow.Id)">
                                @(IsExpanded(tvshow.Id) ? "Hide" : "Details")
                            </button>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(tvshow.Poster_Path))
                            {
                                <a href="https://www.themoviedb.org/tv/@tvshow.Id"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   title="Open @tvshow.Name on TMDB">
                                    <img src="https://image.tmdb.org/t/p/w92@(tvshow.Poster_Path)"
                                         alt="@tvshow.Name poster"
                                         class="img-thumbnail"
                                         style="width: 46px;" />
                                </a>
                            }
                        </td>
                        <td>
                            <strong>@tvshow.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(tvshow.Overview))
                            {
                                <div class="small text-body-secondary text-truncate" style="max-width: 32rem;">
                                    @tvshow.Overview
                                </div>
                            }
                        </td>
                        <td>@tvshow.First_Air_Date</td>
                        <td>@tvshow.VoteAverage.ToString("N1") <span class="text-body-secondary">(@tvshow.VoteCount)</span></td>
                        <td>@tvshow.Popularity.ToString("N1")</td>
                    </tr>

                    @if (IsExpanded(tvshow.Id))
                    {
                        <tr class="table-light">
                            <td colspan="6" class="p-3">
                                <div class="row g-3">
                                    @if (!string.IsNullOrEmpty(tvshow.Poster_Path))
                                    {
                                        <div class="col-auto">
                                            <a href="https://www.themoviedb.org/tv/@tvshow.Id"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                title="Open @tvshow.Name on TMDB">
                                                    <img src="https://image.tmdb.org/t/p/w92@(tvshow.Poster_Path)"
                                                        alt="@tvshow.Name poster"
                                                        class="img-thumbnail"
                                                        style="width: 185px;" />
                                            </a>
                                        </div>
                                    }
                                    <div class="col">
                                        <h5>@tvshow.Name</h5>
                                        <p>@(string.IsNullOrWhiteSpace(tvshow.Overview) ? "No overview available." : tvshow.Overview)</p>
                                        <h6 class="mt-3">Starring</h6>
                                        @if (loadingCredits.Contains(tvshow.Id))
                                        {
                                            <p class="mb-0">Loading cast...</p>
                                        }
                                        else if (creditErrors.TryGetValue(tvshow.Id, out var creditError))
                                        {
                                            <p class="text-danger mb-0">@creditError</p>
                                        }
                                        else if (tvshowCredits.TryGetValue(tvshow.Id, out var credits) && credits.Cast.Count > 0)
                                        {
                                            <ul class="list-group list-group-flush">
                                                @foreach (var castMember in credits.Cast.Take(10))
                                                {
                                                    <li class="list-group-item bg-transparent px-0 py-1">
                                                        <strong>@castMember.Name</strong>
                                                        @if (!string.IsNullOrWhiteSpace(castMember.Character))
                                                        {
                                                            <span class="text-body-secondary"> as @castMember.Character</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="mb-0">No cast information is available.</p>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private TvShowSearchResult? tvshows;
    private string? errorMessage;
    private readonly HashSet<int> expandedTvShowIds = new();
    private readonly HashSet<int> loadingCredits = new();
    private readonly Dictionary<int, TvShowCredits> tvshowCredits = new();
    private readonly Dictionary<int, string> creditErrors = new();

    private bool IsExpanded(int tvshowId) => expandedTvShowIds.Contains(tvshowId);

    private async Task ToggleDetailsAsync(int tvshowId)
    {
        if (!expandedTvShowIds.Add(tvshowId))
        {
            expandedTvShowIds.Remove(tvshowId);
            return;
        }

        if (tvshowCredits.ContainsKey(tvshowId) || loadingCredits.Contains(tvshowId))
        {
            return;
        }

        loadingCredits.Add(tvshowId);
        creditErrors.Remove(tvshowId);

        try
        {
            tvshowCredits[tvshowId] = await Tmdb.GetTvShowCreditsAsync(tvshowId) ?? new TvShowCredits();
        }
        catch (Exception ex)
        {
            creditErrors[tvshowId] = $"Unable to load cast: {ex.Message}";
        }
        finally
        {
            loadingCredits.Remove(tvshowId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tvshows = await Tmdb.GetTopTvShowsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load top tvshows: {ex.Message}";
        }
    }
}
